# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# TypeScript incremental build cache + tsc-emitted config
# (source of truth is vite.config.ts; the .js/.d.ts are generated)
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Rust / Tauri (added in Phase B)
target/
src-tauri/target/

# Local models (downloaded at runtime, never committed)
models/

# Recorded audio (saveAudio setting) and local SQLite data
*.sqlite
*.sqlite-*
*.db
*.wav

# Secrets — never commit API keys or env files (keys live in the OS keychain)
.env
.env.*
!.env.example

# Tauri updater / code-signing private keys
.tauri/
*.key
*.p12
*.keystore

# Editor / OS / tooling
.vscode/*
!.vscode/extensions.json
.idea/
.claude/
.DS_Store
Thumbs.db
desktop.ini
*.local
*.log

# Portable single-exe output
portable/
