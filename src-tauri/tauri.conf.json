{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KaigiAI",
  "version": "0.1.2",
  "identifier": "ai.kaigi.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KaigiAI",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "present-a",
        "url": "present.html",
        "title": "KaigiAI",
        "width": 900,
        "height": 660,
        "resizable": true,
        "visible": false
      },
      {
        "label": "present-b",
        "url": "present.html",
        "title": "KaigiAI",
        "width": 900,
        "height": 660,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
